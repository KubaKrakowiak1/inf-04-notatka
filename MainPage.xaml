             x:Class="mobilna.MainPage">

    <VerticalStackLayout BackgroundColor="AliceBlue">
        <Label TextColor="MediumBlue" FontSize="20">Notatki</Label>
            <CollectionView x:Name="lista">
           
            </CollectionView>

        <Label Text="Dodanie notatki" FontSize="60" TextColor="MediumBlue"></Label>
        <Label Text="Tytuł notatki"></Label>
        <Entry x:Name="tytul"></Entry>
        <Label Text="Treść notatki"></Label>
        <Entry x:Name="tresc"></Entry>
        
        <Button Clicked="Dodaj" Text="Dodaj" TextColor="MediumBlue"></Button>
    </VerticalStackLayout>
</ContentPage>
